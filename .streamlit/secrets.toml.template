# Streamlit Secrets Configuration Template
# Copy this to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to version control!

[email]
# Email notification settings (optional)
smtp_server = "smtp.gmail.com"
smtp_port = 587
smtp_username = "your-email@gmail.com"
smtp_password = "your-app-password"
recipient_email = "recipient@example.com"

[api]
# API keys (if needed)
# yfinance_api_key = "your-key-here"

[database]
# Database settings (using SQLite by default)
db_path = "./data/trading.db"

[general]
# General settings
environment = "production"
debug_mode = false
log_level = "INFO"
